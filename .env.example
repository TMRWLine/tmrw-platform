# Public browser configuration, required to render the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Private server configuration. Never use a VITE_ prefix for these keys.
TWELVELABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=

# Required in production. Use the same HTTPS origin that starts checkout,
# so Stripe returns the sponsor to the browser cookie for the activation grant.
APP_BASE_URL=
